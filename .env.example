# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# PostgreSQL
DB_NAME=lung_new
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# React development server
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Options API cache (seconds)
OPTIONS_CATALOG_CACHE_TIMEOUT=900

# Google GenAI
GOOGLE_API_KEY=your_google_api_key
PRESCRIPTION_EXTRACTION_MODEL=gemini-3.5-flash-lite
PRESCRIPTION_EXTRACTION_PROMPT_VERSION=2.0
# Default blocks outbound document text; local OCR and draft review still work.
# Explicit operator choice: enabled permits configured Gemini calls without billing/hash checks.
# Constrained testing may use approved_non_sensitive after reviewing exact input text.
PRESCRIPTION_GEMINI_DATA_POLICY=disabled
PRESCRIPTION_AGENTIC_EXTRACTION_ENABLED=false
PRESCRIPTION_CHECKPOINT_RETENTION_DAYS=0
PRESCRIPTION_PROVIDER_BUDGET_ENABLED=false
PRESCRIPTION_PROVIDER_BUDGET_SCOPE=
PRESCRIPTION_PROVIDER_BUDGET_WINDOW_SECONDS=60
PRESCRIPTION_PROVIDER_BUDGET_REQUESTS=0
PRESCRIPTION_PROVIDER_BUDGET_TOKEN_UNITS=0
PRESCRIPTION_PROVIDER_MAX_OUTPUT_TOKENS=0
PRESCRIPTION_GEMINI_DATA_APPROVAL_REFERENCE=
PRESCRIPTION_GEMINI_APPROVED_INPUT_SHA256=
# Keep free-tier Gemini calls serialized by running one worker on this queue.
# Tune only after checking this project's active AI Studio quota.
PRESCRIPTION_EXTRACTION_QUEUE=prescription_extraction
PRESCRIPTION_GEMINI_RATE_LIMIT=1/m
PRESCRIPTION_GEMINI_MAX_RETRIES=5
PRESCRIPTION_GEMINI_RETRY_BASE_SECONDS=60
PRESCRIPTION_GEMINI_RETRY_MAX_SECONDS=900
# Invalid structured output is retried quickly before retaining OCR-only review data.
PRESCRIPTION_GEMINI_OUTPUT_MAX_RETRIES=1
PRESCRIPTION_GEMINI_OUTPUT_RETRY_SECONDS=15

# Celery / Redis background worker
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Opt-in graph provider admission; set positive units/time/output cap before enabling.
PRESCRIPTION_DOCUMENT_BUDGET_ENABLED=false
PRESCRIPTION_DOCUMENT_MAX_ATTEMPTS=1
PRESCRIPTION_DOCUMENT_TOKEN_UNITS=0
PRESCRIPTION_DOCUMENT_SECONDS=0
PRESCRIPTION_REPAIR_ENABLED=false
PRESCRIPTION_REPAIR_MAX_ATTEMPTS=1
PRESCRIPTION_REPAIR_TOKEN_UNITS=0
PRESCRIPTION_REPAIR_SECONDS=0

# Optional calendar-day cap; Gemini RPD resets at Pacific midnight.
PRESCRIPTION_PROVIDER_BUDGET_DAILY_REQUESTS=0
PRESCRIPTION_PROVIDER_BUDGET_DAILY_TIMEZONE=America/Los_Angeles
